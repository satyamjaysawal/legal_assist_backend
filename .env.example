GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_USERNAME=default
REDIS_TTL_SECONDS=21600
PROMPT_CACHE_TTL=21600

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB=legal_assist_inhouse
JWT_SECRET=change-this-secret
JWT_HOURS=168

QUDRANT_CLUSTER_ENDPOINT=https://your-cluster.eu-west-2-0.aws.cloud.qdrant.io
QUDRANT_VECTOR_DB_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=legal_assist_docs
GROQ_EMBED_MODEL=nomic-embed-text-v1.5
FASTEMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
GROQ_VISION_MODEL=qwen/qwen3.6-27b
EMBED_DIM=768
MAX_UPLOAD_BYTES=5242880
MONGO_FILES_BUCKET=files
