{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "core/**/*.py",
          "services/**/*.py",
          "agents/**/*.py",
          "connectors/**/*.py",
          "websocket/**/*.py"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
