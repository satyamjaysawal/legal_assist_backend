{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["graph.py", "memory.py", "auth.py", "journeys.py", "cache.py", "embeddings.py", "docs.py", "vectordb.py"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
